# GojoXNG environment variables for Railway deployment
# Copy these to Railway's "Variables" tab

# Railway sets PORT automatically - app listens on this port
# PORT=8080  (Railway sets this automatically)

# The public URL of your GojoXNG instance (set after first deploy)
# Example: https://gojoxng.up.railway.app
SEARXNG_BASE_URL=https://your-app.up.railway.app/

# Secret key - generate with: openssl rand -hex 32
SEARXNG_SECRET=changeme-generate-a-strong-random-secret

# Bind to all interfaces (required for Railway)
SEARXNG_BIND_ADDRESS=0.0.0.0

# Privacy settings
SEARXNG_IMAGE_PROXY=true
SEARXNG_METHOD=POST
SEARXNG_LIMITER=false

# Settings file location
SEARXNG_SETTINGS_PATH=/app/searx/settings.yml
